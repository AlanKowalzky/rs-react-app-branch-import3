{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "baseUrl": ".",   // Ustawienie bazowego katalogu dla ścieżek
    "paths": {
      "@/*": ["src/*"] // Alias @ wskazuje na katalog src
    }
    
  },  
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "include": [
  "src/**/*.ts",
  "src/**/*.tsx"
]
}
